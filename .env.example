# PostgreSQL connection string (used by Drizzle and the app)
DATABASE_URL=postgresql://user:password@localhost:5432/stock_composer

# Better Auth — required in production; min 32 characters (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Canonical app URL for auth callbacks and cookies (use one or both)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: db:seed — first admin user (defaults shown in seed script if unset)
# SEED_ADMIN_EMAIL=admin@stock.local
# SEED_ADMIN_PASSWORD=
# SEED_FORCE=1
